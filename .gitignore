# ---- Secrets: NEVER commit these ----
.env
.env.local
*.env
!.env.example

# ---- Spotify OAuth tokens (contain access/refresh tokens) ----
.cache
.cache-*
cache/spotify_token.json
cache/*.token
*.token

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Test / tooling caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Local classification cache (not secret, but machine-local) ----
cache/*.json
!cache/.gitkeep

# ---- Editors / IDEs ----
.vscode/
.idea/
*.swp
*.swo

# ---- OS junk ----
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
