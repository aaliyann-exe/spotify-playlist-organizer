# ------------------------------------------------------------------
# Copy this file, rename the copy to exactly ".env", then fill it in.
# NEVER share your .env file or commit it to GitHub. It is gitignored.
# ------------------------------------------------------------------

# From your Spotify Developer Dashboard -> your app -> Settings.
SPOTIPY_CLIENT_ID=paste_your_client_id_here

# Also from the dashboard (click "View client secret").
# OPTIONAL: if you leave this blank, the app uses a secretless login
# method called PKCE, which works just as well for a personal script.
SPOTIPY_CLIENT_SECRET=paste_your_client_secret_here

# Must match EXACTLY what you typed in the Spotify dashboard.
# Do not change this unless you know why.
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ------------------------------------------------------------------
# OPTIONAL - leave this out entirely unless you want the extra
# AI classification step (costs a small amount of money).
# See the "Optional AI layer" section of README.md.
# ------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
